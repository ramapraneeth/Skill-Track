# SkillTrack Environment Configuration

# Neon PostgreSQL Database Connection String
DATABASE_URL= "postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require"

# Security & JWT Authentication
SECRET_KEY="your-random-32-character-secret-key"

# Optional Demo Account Seeding Overrides
DEMO_ADMIN_EMAIL="demo.gov@skilltrack.gov.in"
DEMO_ADMIN_PASSWORD="your-strong-admin-password"
DEMO_PROVIDER_EMAIL="demo.provider@skilltrack.gov.in"
DEMO_PROVIDER_PASSWORD="your-strong-provider-password"
DEMO_LEARNER_EMAIL="demo.learner@skilltrack.gov.in"
DEMO_LEARNER_PASSWORD="your-strong-learner-password"
